#!/bin/sh
# Changes reach main only through a pull request that the owner merges (a GitHub ruleset requires it too); this clone
# refuses to push to it directly.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct pushes to main are blocked. Push a branch and open a pull request." >&2
    exit 1
  fi
done
exit 0
